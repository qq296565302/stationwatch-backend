# 应用
NODE_ENV=development
PORT=3000
APP_NAME=duty-guard-api
CORS_ORIGIN=http://localhost:5199

# JWT
JWT_SECRET=duty_guard_super_secret_key_minimum_32_chars_xx
JWT_ACCESS_TOKEN_EXPIRE=2h
JWT_REFRESH_TOKEN_EXPIRE=7d

# 文件
EXPORT_DIR=./exports
TEMPLATE_DIR=./templates
MAX_EXPORT_FILE_SIZE_MB=50

# 日志
LOG_LEVEL=info
LOG_DIR=./logs

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# 数据存储
# memory：进程内 Map，重启即丢
# file  ：本地 JSON 文件，重启保留数据（推荐开发阶段使用，避免反复 seed）
# mongo ：MongoDB，内存缓存 + 异步落库（推荐）
STORAGE_MODE=mongo

# MongoDB 连接串（密码含特殊字符需 URL 编码，@ → %40）
MONGODB_URI=mongodb://root:MongoDB%402025@47.94.196.217:27017/DutyRecord?authSource=admin
# 连接/选主超时（ms）
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# 落库间隔（ms），不设置则回退到 STORAGE_FLUSH_INTERVAL_MS
# MONGODB_FLUSH_INTERVAL_MS=2000

STORAGE_FILE_PATH=./data/duty-guard.json
# 写盘刷新间隔（ms），脏数据定时落盘
STORAGE_FLUSH_INTERVAL_MS=2000
